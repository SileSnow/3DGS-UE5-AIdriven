          },
          "interval_s": {
            "type": "number",
            "description": "间隔秒，默认 1"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "start_video",
      "title_zh": "开始录像",
      "executor": "agent",
      "risk": "low",
