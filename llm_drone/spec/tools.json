    {
      "name": "set_mode",
      "title_zh": "切换模式",
      "executor": "agent",
      "risk": "high",
      "requires_confirm": true,
      "description_zh": "切换运行模式：dry_run(仅校验不执行)/sim(仿真)/real(真机，Phase1 未接入会返回 E_REAL_NOT_AVAILABLE)。real 必须带 confirm=true 且需人工二次确认。",
      "parameters": {
        "type": "object",
