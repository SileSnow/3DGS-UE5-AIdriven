      }
    },
    {
      "name": "stop_video",
      "title_zh": "停止录像",
      "executor": "agent",
      "risk": "low",
      "requires_confirm": false,
      "description_zh": "停止录像。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "return_to_home",
      "title_zh": "一键返航",
      "executor": "agent",
      "risk": "flight",
      "requires_confirm": false,
      "description_zh": "返回起飞点并自动降落。安全动作，无需 confirm，但安全层会校验当前状态。",
      "parameters": {
        "type": "object",
