      }
    },
    {
      "name": "land",
      "title_zh": "原地降落",
      "executor": "agent",
      "risk": "flight",
      "requires_confirm": false,
      "description_zh": "在当前水平位置降落。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "abort",
      "title_zh": "中止任务",
      "executor": "agent",
      "risk": "high",
      "requires_confirm": false,
      "description_zh": "中止当前任务：悬停（可选返航）。高优先级，任何时候可调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
