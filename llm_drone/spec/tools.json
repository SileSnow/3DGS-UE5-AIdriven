      }
    },
    {
      "name": "get_mission_status",
      "title_zh": "任务状态",
      "executor": "agent",
      "risk": "read",
      "requires_confirm": false,
      "description_zh": "查询任务进度/照片列表/电量/状态；mission_id 省略时查最近一次任务。",
      "parameters": {
