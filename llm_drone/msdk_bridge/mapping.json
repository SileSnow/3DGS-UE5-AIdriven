    {
      "name": "plan_capture_mission",
      "executor": "orchestrator",
      "bridge_supported": false,
      "bridge_behavior": "不转发到桥接层；若 /v1/command 收到该 tool 返回 E_UNKNOWN_TOOL（非 agent 白名单）",
      "mapping_to_bridge": "无（Orchestrator 侧规划，产出 plan_id 并在 goto_waypoints 中展开为 waypoints）"
    },
    {
      "name": "takeoff",
      "executor": "agent",
      "bridge_supported": true,
      "http": {
        "endpoint": "POST /v1/command",
        "request_args": "{altitude_m, confirm}"
      },
      "local_facade": "flight/FlightController.takeoff(altitudeM)",
      "calls": [
        {
          "class": "dji.sdk.keyvalue.key.FlightControllerKey",
          "method": "KeyStartTakeoff（DJIActionKeyInfo<EmptyMsg,EmptyMsg>）.create().action(onSuccess, onFailure)",
          "callback": "CompletionCallbackWithParam<EmptyMsg>",
          "since": "5.0.0",
          "source": "S1 + S13",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.FlightControllerKey",
          "method": "KeyStopTakeoff（中止起飞）",
          "callback": "CompletionCallback",
          "since": "5.0.0",
          "source": "S1",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.v5.manager.aircraft.virtualstick.VirtualStickManager",
          "method": "enableVirtualStick / setVirtualStickAdvancedModeEnabled(true) / sendVirtualStickAdvancedParam(VirtualStickFlightControlParam) 爬升到 altitude_m / disableVirtualStick",
          "callback": "CompletionCallback + 状态轮询",
          "since": "5.0.0/5.1.0",
          "source": "S9 + S15 + S20",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.FlightControllerKey",
          "method": "KeyIsFlying / KeyAltitude（到位判定）",
          "callback": "listen",
          "since": "5.0.0",
          "source": "S1",
          "status": "verified-from-docs"
        }
      ],
      "notes": "MSDK 的 KeyStartTakeoff 无高度参数（自动起飞至约 1.2m 悬停），因此到指定相对高度需接管控制权用虚拟摇杆垂直爬升；虚拟摇杆需要遥控器处于 N 档且不在自动任务中。若虚拟摇杆不可用，降级方案=直接执行首个航点的 KMZ 任务（由飞控爬升）。"
    },
    {
      "name": "goto_waypoints",
      "executor": "agent",
      "bridge_supported": true,
      "http": {
        "endpoint": "POST /v1/command",
        "request_args": "{mission:{...}, speed_mps?, take_photos?, photo_interval_s?, confirm}；桥接层要求 Orchestrator 已把 plan_id 展开为 waypoints"
      },
      "local_facade": "mission/MissionExecutor.execute(mission) -> mission/WaypointMissionController + mission/WaypointConverter + camera/CameraController",
      "calls": [
        {
          "class": "com.dji:wpmzsdk:1.0.5.2（WPMZ SDK，可选）/ 自建 WPML",
          "method": "构建 KMZ（template.kml + waylines.wpml）",
          "callback": "本地文件",
          "since": "MSDK 5.6.0 起官方提供 IWPMZManager；KMZ 上传自 5.0.0",
          "source": "S18 + S19 + S11",
          "status": "unverified（已按 research/10 重写，仍未真机验证）"
        },
        {
          "class": "dji.v5.manager.aircraft.waypoint3.WaypointMissionManager",
          "method": "pushKMZFileToAircraft(String missionFilePath, CompletionCallbackWithProgress<Double>)",
          "callback": "onProgressUpdate/onSuccess/onFailure",
          "since": "5.0.0",
          "source": "S5 + S12",
          "status": "unverified（已按 research/10 重写，仍未真机验证）"
        },
        {
          "class": "dji.v5.manager.aircraft.waypoint3.WaypointMissionManager",
          "method": "getAvailableWaylineIDs(missionFileName): List<Integer>",
          "callback": "同步",
          "since": "5.1.0",
          "source": "S5",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.v5.manager.aircraft.waypoint3.WaypointMissionManager",
          "method": "startMission(missionFileName, waylineIDs, CompletionCallback)",
          "callback": "CompletionCallback",
          "since": "5.1.0",
          "source": "S5 + S12",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.v5.manager.aircraft.waypoint3.WaypointMissionManager",
          "method": "pauseMission / resumeMission / stopMission(missionFileName, callback)",
          "callback": "CompletionCallback",
          "since": "5.0.0",
          "source": "S5 + S12",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.v5.manager.aircraft.waypoint3.WaypointMissionManager",
