  "tools": [
    {
      "name": "get_telemetry",
      "executor": "agent",
      "bridge_supported": true,
      "http": {
        "endpoint": "POST /v1/command (tool=get_telemetry) 或 GET /v1/telemetry",
        "request_args": "{}"
      },
      "local_facade": "bridge/TelemetryPublisher.snapshot()",
      "calls": [
        {
          "class": "dji.v5.manager.KeyManager",
          "method": "getValue(DJIKey, default)",
          "callback": "同步（MSDK 缓存）",
          "since": "5.0.0",
          "source": "S4",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.FlightControllerKey",
          "method": "KeyAircraftLocation3D / KeyAltitude / KeyTakeoffLocationAltitude / KeyHomeLocation / KeyAircraftVelocity / KeyFlightMode / KeyGPSSatelliteCount / KeyGPSSignalLevel / KeyIsFlying / KeyIsFailsafe / KeyGoHomeStatus",
          "callback": "listen(listenHolder, KeyListener)",
          "since": "5.0.0",
          "source": "S1",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.BatteryKey",
          "method": "KeyChargeRemainingInPercent（整数电量）",
          "callback": "getValue/listen",
          "since": "5.0.0",
          "source": "S1/官方版本差异表",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.GimbalKey",
          "method": "KeyGimbalAttitude（Attitude: pitch/roll/yaw）",
          "callback": "getValue/listen",
          "since": "5.0.0",
          "source": "S3",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.RemoteControllerKey",
          "method": "KeyConnection（RC 链路）",
          "callback": "getValue/listen",
          "since": "5.0.0",
          "source": "官方版本差异表 + RCKey页",
          "status": "verified-from-docs"
        },
        {
          "class": "dji.sdk.keyvalue.key.AirLinkKey",
          "method": "图传/链路信号质量（具体 Key 名待确认）",
          "callback": "getValue/listen",
          "since": "5.x",
          "source": "—",
          "status": "unverified"
        }
      ],
      "notes": "alt_abs_m = KeyTakeoffLocationAltitude + KeyAltitude；gps.fix 由 KeyGPSSignalLevel 枚举映射（MSDK 5.10.0 起该枚举 deprecated，TODO 改用 getPositioningSolution）；sim_time_s 在 real 模式返回 null（唯一字段差异，见 PROTOCOL_COMPLIANCE.md）"
    },
