    {
      "spec_code": "E_GEOFENCE",
      "when": "本地圆形围栏校验失败（300m 默认）",
      "msdk_source": "本地 SafetyGuard"
    },
    {
      "spec_code": "E_ALT_LIMIT / E_SPEED_LIMIT / E_PARAM_RANGE / E_SCHEMA",
      "when": "本地参数校验",
      "msdk_source": "本地 SafetyGuard"
    },
    {
      "spec_code": "E_CONFIRM_REQUIRED",
      "when": "takeoff/goto_waypoints/set_mode(real) 未带 confirm",
      "msdk_source": "本地 SafetyGuard"
    },
    {
      "spec_code": "E_NOT_AIRBORNE",
      "when": "拍照/云台/录像命令在当前非空中状态",
      "msdk_source": "状态机"
    },
    {
      "spec_code": "E_NOT_SUPPORTED",
      "when": "sim 模式、/v1/reset、/v1/sim/config 等仿真专属能力",
