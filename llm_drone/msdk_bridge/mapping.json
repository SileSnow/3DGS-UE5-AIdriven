      "when": "任务执行中收到并发飞行命令",
      "msdk_source": "桥接层"
    },
    {
      "spec_code": "E_BATTERY_TAKEOFF",
      "when": "BatteryKey 电量 < 30%",
      "msdk_source": "BatteryKey.KeyChargeRemainingInPercent"
