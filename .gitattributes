# 统一换行与二进制识别
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.cff  text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

